# Runtime environment
APP_ENV=development
LOG_LEVEL=debug

# Least-privilege runtime database connection.
# Never use DATABASE_MIGRATION_URL in this service.
DATABASE_URL=postgresql://mucyora_auth_app:replace-me@localhost:5432/mucyora?sslmode=require&connection_limit=10&pool_timeout=10

# The HTTP port is fixed to 3000 in src/main.ts.

# Comma-separated exact browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:4000

# Dependency readiness results are cached briefly to protect the database.
READINESS_CACHE_TTL_MS=5000

# API documentation is disabled unless explicitly enabled.
# Production documentation also requires the credentials below.
ENABLE_SWAGGER=false
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASS=
